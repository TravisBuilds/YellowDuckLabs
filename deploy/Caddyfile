{
	email {$ACME_EMAIL}
}

# Reachable by IP before DNS / TLS is ready.
http://{$PUBLIC_IP} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}

# www has a valid Let's Encrypt cert. Serve the app here.
www.{$DOMAIN} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}

# HTTP apex → www. HTTPS apex is issued separately; until that cert
# exists, use www. Do not send browsers to https://apex.
http://{$DOMAIN} {
	redir https://www.{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	redir https://www.{$DOMAIN}{uri} permanent
}
