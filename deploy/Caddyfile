{
	email {$ACME_EMAIL}
}

# Reachable by IP before GoDaddy DNS is pointed. HTTPS for the names
# starts working once the A records resolve here.
http://{$PUBLIC_IP} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	# FastAPI: municipalities, geo, analyst, and the process health probe.
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
