# Copy to .env.production on the VPS. Never commit the real file.

DOMAIN=yellowducklabs.org
ACME_EMAIL=firewatch@yellowducklabs.org
PUBLIC_IP=

POSTGRES_USER=firewatch
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=firewatch

DATABASE_URL=postgresql+psycopg://firewatch:change-me-to-a-long-random-string@db:5432/firewatch

FIRMS_MAP_KEY=
ANTHROPIC_API_KEY=
FIREWATCH_LLM_MODEL=claude-sonnet-4-5
FIREWATCH_CONTACT=firewatch@yellowducklabs.org

# Public site URL for links in alert emails.
PUBLIC_WEB_URL=https://www.yellowducklabs.org

# Transactional email for priority alerts (optional until SMTP is configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=firewatch@yellowducklabs.org
SMTP_USE_TLS=true
