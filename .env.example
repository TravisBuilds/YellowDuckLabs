# ---------------------------------------------------------------------------
# Fire Watch environment configuration
# Copy to .env and fill in.  Everything here is optional except the database.
# ---------------------------------------------------------------------------

POSTGRES_USER=firewatch
POSTGRES_PASSWORD=firewatch
POSTGRES_DB=firewatch
# Host port for Postgres. 5433 avoids clashing with a local Postgres on 5432.
POSTGRES_PORT=5433

API_PORT=8000
WEB_PORT=3000

# Used when running the backend outside Docker (e.g. pytest on the host).
DATABASE_URL=postgresql+psycopg://firewatch:firewatch@localhost:5433/firewatch

# ---------------------------------------------------------------------------
# NASA FIRMS
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without this, the FIRMS adapter reports status=UNAVAILABLE rather than
# fabricating detections.
# ---------------------------------------------------------------------------
FIRMS_MAP_KEY=

# ---------------------------------------------------------------------------
# AI analyst.  Without a key the analyst still runs: it executes the same
# structured tools and returns a deterministic, evidence-only answer with no
# natural-language synthesis.  It never invents values in either mode.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
FIREWATCH_LLM_MODEL=claude-sonnet-4-5

# Contact string sent in the User-Agent for public APIs (OSM/Overpass etiquette).
FIREWATCH_CONTACT=firewatch@yellowducklabs.org

# Public site URL for links in alert emails.
PUBLIC_WEB_URL=http://localhost:3000

# Transactional email for priority alerts (optional in local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
